        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (page_url) (count_over_time({service_name=\"roomy-app-lite\"} | logfmt [7d])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top routes (page views, last 7 days)",
      "type": "table"
    },
