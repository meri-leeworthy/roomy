        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "count(count by (user_id) (count_over_time({service_name=\"roomy-app-lite\"} | logfmt | user_id != \"\" [$__interval])))",
          "legendFormat": "users",
          "queryType": "range",
          "refId": "A"
        }
      ],
