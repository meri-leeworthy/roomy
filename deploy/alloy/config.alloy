// Grafana Alloy config — Roomy production log collector (Grafana Cloud).
//
// Receives logs from the Railway app services and forwards them to Grafana
// Cloud Loki. The apps POST to this collector (see deploy/alloy/README.md).
//
// Required env vars:
//   - GRAFANA_CLOUD_LOKI_URL    full push URL, e.g.
//                               https://logs-prod-<region>.grafana.net/loki/api/v1/push
//   - GRAFANA_CLOUD_LOKI_ID     Grafana Cloud Loki instance ID (basic auth user)
//   - GRAFANA_CLOUD_LOKI_TOKEN  Grafana Cloud access policy token (basic auth pass)
//
// Optional: ALLOY_LOG_LEVEL (default `info`).
//
// Faro browser-agent receiver (app-lite client-side logs):
//   - FARO_CORS_ORIGINS  comma-separated allowed browser origins (default:
//                         https://app.roomy.chat — the Caddyfile app origin)
//   - FARO_API_KEY       shared secret the Faro agent must present; default
//                        "bad_api_key" (matching compose.yaml dev) — set a
//                        real secret in production.

logging {
	level = "info" // override via ALLOY_LOG_LEVEL at runtime if desired
}

// ── Ship to Grafana Cloud Loki ────────────────────────────────────────
loki.write "cloud" {
	endpoint {
		url = env("GRAFANA_CLOUD_LOKI_URL")
		basic_auth {
			username = env("GRAFANA_CLOUD_LOKI_ID")
			password = env("GRAFANA_CLOUD_LOKI_TOKEN")
		}
	}
}

// ── Receive browser logs from app-lite (Grafana Faro agent) ───────────
// app-lite is a static SPA (adapter-static behind Caddy) with no server
// stdout, so its logs arrive over HTTP from the browser. The Faro agent
// POSTs console/error payloads here and they are forwarded to Loki (logs)
// exactly like the Loki-push apps. No traces in prod — there is no Tempo.
faro.receiver "frontend" {
	server {
		listen_address       = "0.0.0.0"
		listen_port          = 12345
		cors_allowed_origins = split(",", env("FARO_CORS_ORIGINS", "https://app.roomy.chat"))
		api_key              = env("FARO_API_KEY", "bad_api_key")
		max_allowed_payload_size = "10MiB"

		rate_limiting {
			rate = 10
		}
	}

	sourcemaps { }

	output {
		logs = [loki.write.cloud.receiver]
	}
}

// ── Receive logs from the Roomy app services ─────────────────────────
// Loki Push API receiver. Each app forwards its stdout here over the
// Railway private network. The forwarder POSTs Loki-compatible JSON to
//   http://<alloy>:3100/loki/api/v1/push
loki.source.api "apps" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 3100
	}
	forward_to = [loki.write.cloud.receiver]
}

// ── Optional: OTLP logs receiver (4317 gRPC / 4318 HTTP) ─────────────
// Enable if you later instrument an app with OpenTelemetry and want to send
// OTLP logs directly to Alloy instead of the Loki push API above.
otelcol.receiver.otlp "apps" {
	grpc { endpoint = "0.0.0.0:4317" }
	http  { endpoint = "0.0.0.0:4318" }

	output {
		logs = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		logs = [otelcol.exporter.loki.apps.input]
	}
}

otelcol.exporter.loki "apps" {
	forward_to = [loki.write.cloud.receiver]
}
