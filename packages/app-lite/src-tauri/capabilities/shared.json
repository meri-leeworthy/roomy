{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shared-capabilities",
  "description": "enables the shared permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        }
      ]
    },
    "os:default",
    "log:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://roomy.space/*"
        }
      ]
    }
  ]
}