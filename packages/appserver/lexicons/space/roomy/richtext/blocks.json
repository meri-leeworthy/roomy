{
  "lexicon": 1,
  "id": "space.roomy.richtext.blocks",
  "description": "The open block union for the blocks+facets rich text representation. Unknown block types are tolerated by consumers (open union).",
  "defs": {
    "block": {
      "type": "union",
      "description": "An open union of block types. Unknown block $types are dropped by renderers (their text is lost unless the block carries one).",
      "closed": false,
      "refs": [
        "space.roomy.richtext.blocks#text",
        "space.roomy.richtext.blocks#header",
        "space.roomy.richtext.blocks#blockquote",
        "space.roomy.richtext.blocks#small",
        "space.roomy.richtext.blocks#code",
        "space.roomy.richtext.blocks#orderedList",
        "space.roomy.richtext.blocks#unorderedList",
        "space.roomy.richtext.blocks#image",
        "space.roomy.richtext.blocks#horizontalRule"
      ]
    },
    "text": {
      "type": "object",
      "description": "A paragraph of text with optional inline annotations.",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "facets": {
          "type": "array",
          "items": { "type": "ref", "ref": "space.roomy.richtext.facet#main" }
        }
      }
    },
    "header": {
      "type": "object",
      "description": "A heading of the given level (1-6).",
      "required": ["text", "level"],
      "properties": {
        "text": { "type": "string" },
        "facets": {
          "type": "array",
          "items": { "type": "ref", "ref": "space.roomy.richtext.facet#main" }
        },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "blockquote": {
      "type": "object",
      "description": "A quoted block of text.",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "facets": {
          "type": "array",
          "items": { "type": "ref", "ref": "space.roomy.richtext.facet#main" }
        }
      }
    },
    "small": {
      "type": "object",
      "description": "Small text (Discord `-# small text`), rendered smaller than body text.",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "facets": {
          "type": "array",
          "items": { "type": "ref", "ref": "space.roomy.richtext.facet#main" }
        }
      }
    },
    "code": {
      "type": "object",
      "description": "A code block with an optional language hint.",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "language": { "type": "string" }
      }
    },
    "listItem": {
      "type": "object",
      "description": "A single list item's text and inline annotations.",
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "facets": {
          "type": "array",
          "items": { "type": "ref", "ref": "space.roomy.richtext.facet#main" }
        }
      }
    },
    "orderedList": {
      "type": "object",
      "description": "An ordered (numbered) list.",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "type": "ref", "ref": "space.roomy.richtext.blocks#listItem" }
        }
      }
    },
    "unorderedList": {
      "type": "object",
      "description": "An unordered (bulleted) list.",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "type": "ref", "ref": "space.roomy.richtext.blocks#listItem" }
        }
      }
    },
    "image": {
      "type": "object",
      "description": "An image block.",
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "alt": { "type": "string" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 }
      }
    },
    "horizontalRule": {
      "type": "object",
      "description": "A thematic break (horizontal rule).",
      "properties": {}
    }
  }
}
