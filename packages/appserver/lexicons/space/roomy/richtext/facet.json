{
  "lexicon": 1,
  "id": "space.roomy.richtext.facet",
  "description": "Byte-indexed annotations over block text, with an open feature union. Facet indices are UTF-8 byte offsets (byteStart inclusive, byteEnd exclusive), matching app.bsky.richtext.facet#byteSlice.",
  "defs": {
    "main": {
      "type": "object",
      "description": "An annotation over a byte range of a block's text.",
      "required": ["index", "features"],
      "properties": {
        "index": { "type": "ref", "ref": "space.roomy.richtext.facet#byteSlice" },
        "features": {
          "type": "array",
          "items": { "type": "ref", "ref": "space.roomy.richtext.facet#feature" }
        }
      }
    },
    "byteSlice": {
      "type": "object",
      "description": "A UTF-8 byte range into the block text: start inclusive, end exclusive.",
      "required": ["byteStart", "byteEnd"],
      "properties": {
        "byteStart": { "type": "integer", "minimum": 0 },
        "byteEnd": { "type": "integer", "minimum": 0 }
      }
    },
    "feature": {
      "type": "union",
      "description": "An open union of facet features. Unknown feature $types are tolerated by consumers (rendered as plain text).",
      "closed": false,
      "refs": [
        "space.roomy.richtext.facet#bold",
        "space.roomy.richtext.facet#italic",
        "space.roomy.richtext.facet#strikethrough",
        "space.roomy.richtext.facet#underline",
        "space.roomy.richtext.facet#code",
        "space.roomy.richtext.facet#highlight",
        "space.roomy.richtext.facet#link",
        "space.roomy.richtext.facet#didMention",
        "space.roomy.richtext.facet#atMention",
        "space.roomy.richtext.facet#roomRef"
      ]
    },
    "bold": {
      "type": "object",
      "description": "Bold text.",
      "properties": {}
    },
    "italic": {
      "type": "object",
      "description": "Italic text.",
      "properties": {}
    },
    "strikethrough": {
      "type": "object",
      "description": "Strikethrough text.",
      "properties": {}
    },
    "underline": {
      "type": "object",
      "description": "Underlined text.",
      "properties": {}
    },
    "code": {
      "type": "object",
      "description": "Inline code.",
      "properties": {}
    },
    "highlight": {
      "type": "object",
      "description": "Highlighted text.",
      "required": ["color"],
      "properties": {
        "color": { "type": "string" }
      }
    },
    "link": {
      "type": "object",
      "description": "A hyperlink spanning the facet range.",
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "format": "uri" }
      }
    },
    "didMention": {
      "type": "object",
      "description": "A user mention resolved to a DID.",
      "required": ["did"],
      "properties": {
        "did": { "type": "string" }
      }
    },
    "atMention": {
      "type": "object",
      "description": "A mention resolved to an at-uri (interop form of #didMention).",
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string" }
      }
    },
    "roomRef": {
      "type": "object",
      "description": "An internal reference to a Roomy space (and optionally a room within it).",
      "required": ["spaceId"],
      "properties": {
        "spaceId": { "type": "string" },
        "roomId": { "type": "string" }
      }
    }
  }
}
